{
  "manifest_version": 3,
  "name": "KYVORIX Local Browser Control",
  "version": "1.1.0",
  "description": "User-controlled page reading and browser actions that run locally.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KYVORIX Browser Control",
    "default_popup": "popup.html"
  }
}
