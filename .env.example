# NEXO AI — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel: Project Settings → Environment Variables → add both keys.

# Free model routing
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Nexo application database and authenticated browser sessions
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only. Never prefix this variable with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OAuth integration credentials — configure the same callback URLs used by the app.
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_APP_SLUG=your_github_app_slug_optional
VERCEL_CLIENT_ID=your_vercel_oauth_client_id
VERCEL_CLIENT_SECRET=your_vercel_oauth_client_secret
SUPABASE_OAUTH_CLIENT_ID=your_supabase_oauth_client_id
SUPABASE_OAUTH_CLIENT_SECRET=your_supabase_oauth_client_secret

# Optional dedicated key for encrypting stored integration tokens and signing
# OAuth state. If omitted, the server-role key is used as a fallback.
INTEGRATION_TOKEN_ENCRYPTION_KEY=generate_a_long_random_server_only_secret

# Optional visual web-page capture. Keep this server-only.
SCREENSHOTONE_API_KEY=your_screenshotone_key_optional

# Optional legacy/fallback integrations. Leave unset unless the related feature
# is intentionally configured.
GITHUB_MODELS_TOKEN=your_github_models_token_optional
VERCEL_TOKEN=your_vercel_token_optional
